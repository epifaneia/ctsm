# Copia este fichero a .env y ajusta lo que necesites.

# --- Backend de inferencia (solo lo usa s4) ---
# ollama = AIR-GAP, nada sale de la máquina (DEFAULT).
# gemini = nube: la documentación del proveedor viaja a Google. Solo con clave
#          de tier de pago/Vertex y con el cliente informado.
# CTSM_LLM_BACKEND=ollama

# --- Ollama (local) ---
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# CTSM_OLLAMA_MODEL=qwen2.5:7b
# num_ctx: NO bajarlo a ciegas. Ollama trunca el prompt en silencio y el modelo
# acabaría citando sobre documentación que no vio. 10 chunks ~ 7.500 tokens.
# CTSM_OLLAMA_NUM_CTX=16384

# --- Gemini (solo si CTSM_LLM_BACKEND=gemini) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-pro-preview

# Contraseñas de PDFs cifrados de proveedor (s2). Varias separadas por ';',
# se prueban en orden sobre cada PDF que la pida.
# CTSM_PDF_PASSWORDS=clave_del_manual;otra_clave

# --- custodia: los tres cables de integracion (docs/INTEGRATION.md) ---
# CUSTODIA_ACTOR=ana.garcia            # obligatorio: el pipeline no corre sin actor
# CUSTODIA_LEDGER=logs/custody.jsonl   # libro de custodia (o - para stdout)
# CUSTODIA_SIGNING_KEY=                # clave local de firma; la empresa la sustituye por su PKI
